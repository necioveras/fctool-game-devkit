{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fctool.local/schemas/game-manifest-1.0.json",
  "title": "FCTool Game Manifest 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fctoolGame",
    "id",
    "name",
    "version",
    "entrypoint",
    "metadata",
    "outputs",
    "responsive"
  ],
  "properties": {
    "fctoolGame": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 80
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "entrypoint": {
      "type": "string",
      "pattern": "^(?!/)(?!.*\\.\\.)[^\\0]+\\.html?$"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "author": {
          "type": "string",
          "maxLength": 120
        },
        "license": {
          "type": "string",
          "maxLength": 80
        },
        "language": {
          "type": "string",
          "maxLength": 35,
          "description": "Idioma principal sugerido, preferencialmente tag BCP 47, por exemplo pt-BR."
        },
        "suggestedAreas": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "uniqueItems": true,
          "maxItems": 20
        },
        "suggestedSubjects": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "uniqueItems": true,
          "maxItems": 30
        },
        "suggestedTopics": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "uniqueItems": true,
          "maxItems": 50
        },
        "suggestedEducationLevels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "uniqueItems": true,
          "maxItems": 20
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "uniqueItems": true,
          "maxItems": 50
        },
        "thumbnail": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\.\\.)[^\\0]+\\.(png|jpe?g|webp|svg)$"
        }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "score",
        "completion",
        "events"
      ],
      "properties": {
        "score": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "minimum": { "type": "number" },
            "maximum": { "type": "number" }
          }
        },
        "completion": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema"],
          "properties": {
            "schema": { "$ref": "#/$defs/outputSchema" }
          }
        },
        "events": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{0,79}$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["description", "schema"],
            "properties": {
              "description": { "type": "string", "minLength": 1, "maxLength": 500 },
              "schema": { "$ref": "#/$defs/outputSchema" }
            }
          }
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/configField"
      },
      "default": {}
    },
    "responsive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "touch",
        "orientations"
      ],
      "properties": {
        "touch": {
          "type": "boolean",
          "const": true,
          "description": "Ações essenciais devem ser operáveis por toque."
        },
        "orientations": {
          "type": "array",
          "items": {
            "enum": [
              "portrait",
              "landscape"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "preferredOrientation": {
          "enum": [
            "portrait",
            "landscape",
            "any"
          ],
          "default": "any"
        }
      }
    }
  },
  "$defs": {
    "outputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["object", "string", "number", "integer", "boolean"] },
        "required": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "properties": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/outputSchema" }
        },
        "additionalProperties": { "type": "boolean", "default": false },
        "enum": { "type": "array", "minItems": 1, "uniqueItems": true },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "minLength": { "type": "integer", "minimum": 0 },
        "maxLength": { "type": "integer", "minimum": 0 }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "object" } }, "required": ["type"] },
          "then": { "required": ["properties"] }
        }
      ]
    },
    "configField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "label"
      ],
      "properties": {
        "type": {
          "enum": [
            "boolean",
            "number",
            "text",
            "select"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "default": {},
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "step": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "options": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": [
                  "string",
                  "number"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "value",
                  "label"
                ],
                "properties": {
                  "value": {
                    "type": [
                      "string",
                      "number"
                    ]
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  }
                }
              }
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "required": {
          "type": "boolean",
          "default": false
        },
        "help": {
          "type": "string",
          "maxLength": 500
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "select"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "options"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "boolean"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "default": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "number"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "default": {
                "type": "number"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "text"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "default": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "select"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "default": {
                "type": [
                  "string",
                  "number"
                ]
              }
            }
          }
        }
      ]
    }
  }
}
