{
  "fctoolGame": "1.0",
  "id": "hello-game",
  "name": "Hello FCTool Game",
  "version": "1.0.0",
  "entrypoint": "index.html",
  "metadata": {
    "description": "Exemplo mínimo para testar handshake, pontuação, telemetria e conclusão.",
    "author": "FCTool",
    "language": "pt-BR",
    "suggestedAreas": [
      "Demonstração"
    ],
    "suggestedSubjects": [
      "Integração"
    ],
    "suggestedTopics": [
      "FCTool Game Protocol"
    ],
    "suggestedEducationLevels": [
      "Teste"
    ],
    "keywords": [
      "exemplo",
      "integração",
      "SDK"
    ]
  },
  "outputs": {
    "score": {
      "enabled": true,
      "minimum": 0,
      "maximum": 100
    },
    "completion": {
      "schema": {
        "type": "object",
        "required": ["score", "result"],
        "properties": {
          "score": { "type": "number", "minimum": 0, "maximum": 100 },
          "result": { "type": "string", "enum": ["success", "finished"] }
        },
        "additionalProperties": false
      }
    },
    "events": {
      "attempt": {
        "description": "Tentativa iniciada pelo estudante.",
        "schema": {
          "type": "object",
          "required": ["success", "number"],
          "properties": {
            "success": { "type": "boolean" },
            "number": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        }
      },
      "score_changed": {
        "description": "Pontuação alterada.",
        "schema": {
          "type": "object",
          "required": ["score"],
          "properties": {
            "score": { "type": "number", "minimum": 0, "maximum": 100 }
          },
          "additionalProperties": false
        }
      },
      "hint_requested": {
        "description": "Dica solicitada pelo estudante.",
        "schema": {
          "type": "object",
          "required": ["score"],
          "properties": {
            "score": { "type": "number", "minimum": 0, "maximum": 100 }
          },
          "additionalProperties": false
        }
      }
    }
  },
  "configuration": {
    "initialLevel": {
      "type": "select",
      "label": "Fase inicial",
      "options": [
        {
          "value": "level-1",
          "label": "Fase 1"
        },
        {
          "value": "level-2",
          "label": "Fase 2"
        },
        {
          "value": "level-3",
          "label": "Fase 3"
        }
      ],
      "default": "level-1",
      "required": true,
      "help": "Define a fase em que o estudante iniciará a sessão."
    },
    "difficulty": {
      "type": "select",
      "label": "Dificuldade",
      "options": [
        {
          "value": "easy",
          "label": "Fácil"
        },
        {
          "value": "medium",
          "label": "Média"
        },
        {
          "value": "hard",
          "label": "Difícil"
        }
      ],
      "default": "medium"
    },
    "sound": {
      "type": "boolean",
      "label": "Som",
      "default": true
    }
  },
  "responsive": {
    "touch": true,
    "orientations": [
      "portrait",
      "landscape"
    ],
    "preferredOrientation": "any"
  }
}
